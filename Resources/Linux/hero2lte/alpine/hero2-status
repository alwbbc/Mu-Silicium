#!/bin/sh
echo "Galaxy S7 Edge - Alpine on Mu-Silicium UEFI"
echo "CPUs: $(nproc)  $(grep MemTotal /proc/meminfo)  $(date)"
echo "waiting for deferred probes (uptime $(cut -d. -f1 /proc/uptime)s)..."
while [ $(cut -d. -f1 /proc/uptime) -lt 20 ]; do sleep 1; done
echo "--- driver binding ---"
for d in 10550000.i2c 14e10000.i2c 13690000.i2c 10570000.clock-controller 14c90000.pinctrl 14ca0000.pinctrl 14cc0000.pinctrl 14cd0000.pinctrl 14ce0000.pinctrl; do
  p=/sys/bus/platform/devices/$d
  if [ -e $p/driver ]; then echo "$d: bound to $(basename $(readlink $p/driver))";
  elif [ -e $p ]; then echo "$d: NOT bound $(cat $p/waiting_for_supplier 2>/dev/null)"; else echo "$d: no device"; fi
done
echo "i2c devices: $(ls /sys/bus/i2c/devices | tr '\n' ' ')"
echo "--- dmesg: errors / deferred / touch ---"
dmesg | grep -iE "defer|pending|fail|error|s6sa|touch|14e10000|hsi2c|regulator|ldo3[23]|supply" | grep -v "using zero-initial" | tail -n 25
echo "--- input devices ---"
grep -E "^N:" /proc/bus/input/devices
echo "--- events ---"
exec /usr/bin/keylog
