#include <Library/PcdLib.h>

#include <IndustryStandard/Acpi.h>

//
// FADT Table
//
EFI_ACPI_6_6_FIXED_ACPI_DESCRIPTION_TABLE FadtTable = {
  //
  // ACPI Table Header
  //
  .Header = {
    .Signature        = EFI_ACPI_6_6_FIXED_ACPI_DESCRIPTION_TABLE_SIGNATURE,
    .Length           = sizeof (EFI_ACPI_6_6_FIXED_ACPI_DESCRIPTION_TABLE),
    .Revision         = EFI_ACPI_6_6_FIXED_ACPI_DESCRIPTION_TABLE_REVISION,
    .OemId            = {'S', 'A', 'M', 'S', 'U', 'N'},
    .OemTableId       = FixedPcdGet64 (PcdAcpiDefaultOemTableId),
    .OemRevision      = FixedPcdGet32 (PcdAcpiDefaultOemRevision),
    .CreatorId        = FixedPcdGet32 (PcdAcpiDefaultCreatorId),
    .CreatorRevision  = FixedPcdGet32 (PcdAcpiDefaultCreatorRevision)
  },

  //
  // Power Mode Profile
  //
  .PreferredPmProfile = EFI_ACPI_6_6_PM_PROFILE_TABLET,

  //
  // Flags
  //
  .Flags              = EFI_ACPI_6_6_HW_REDUCED_ACPI | EFI_ACPI_6_6_LOW_POWER_S0_IDLE_CAPABLE |
                        EFI_ACPI_6_6_RESET_REG_SUP,
  // Windows ARM64 will not start without the PSCI flag. Samsung's EL3 only has
  // PSCI 0.1 (no SYSTEM_RESET), so also offer the ACPI reset register:
  // PMU SWRESET (0x105C0400), write 1.
  .ArmBootArch        = EFI_ACPI_6_6_ARM_PSCI_COMPLIANT,
  .ResetReg           = { EFI_ACPI_6_6_SYSTEM_MEMORY, 32, 0, EFI_ACPI_6_6_DWORD, 0x105C0400 },
  .ResetValue         = 1,

  //
  // Hypervisor
  //
  .HypervisorVendorIdentity = 0x474E55534D4153
};

//
// FADT Table Reference
//
VOID *ReferenceAcpiTable = (VOID*)&FadtTable;
