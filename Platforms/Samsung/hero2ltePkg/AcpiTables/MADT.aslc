#include <Library/PcdLib.h>

#include <IndustryStandard/Acpi.h>

//
// MADT Table Structure
//
typedef struct {
  EFI_ACPI_6_6_MULTIPLE_APIC_DESCRIPTION_TABLE_HEADER MadtHeader;
  EFI_ACPI_6_6_GIC_STRUCTURE                          GicC[4];
  EFI_ACPI_6_6_GIC_DISTRIBUTOR_STRUCTURE              GicD;
} EFI_ACPI_6_6_MULTIPLE_APIC_DESCRIPTION_TABLE;

//
// MADT Table
//
EFI_ACPI_6_6_MULTIPLE_APIC_DESCRIPTION_TABLE MadtTable = {
  //
  // MADT Table Header
  //
  .MadtHeader = {
    //
    // ACPI Table Header
    //
    .Header = {
      .Signature                     = EFI_ACPI_6_6_MULTIPLE_APIC_DESCRIPTION_TABLE_SIGNATURE,
      .Length                        = sizeof (EFI_ACPI_6_6_MULTIPLE_APIC_DESCRIPTION_TABLE),
      .Revision                      = EFI_ACPI_6_6_MULTIPLE_APIC_DESCRIPTION_TABLE_REVISION,
      .OemId                         = {'S', 'A', 'M', 'S', 'U', 'N'},
      .OemTableId                    = FixedPcdGet64 (PcdAcpiDefaultOemTableId),
      .OemRevision                   = FixedPcdGet32 (PcdAcpiDefaultOemRevision),
      .CreatorId                     = FixedPcdGet32 (PcdAcpiDefaultCreatorId),
      .CreatorRevision               = FixedPcdGet32 (PcdAcpiDefaultCreatorRevision)
    }
  },

  //
  // GIC CPU Interfaces
  //
  //
  // GIC CPU Interfaces
  // Only the Cortex-A53 cluster is exposed: the Mongoose M1 cores have a TLB
  // conflict errata (see Linux exynos8890.dtsi).
  //
  .GicC = {
    //
    // Core 0 (Cortex-A53, MPIDR 0x100; cluster 1 -> GIC CPU interface 4)
    //
    [0] = {
      .Type                          = EFI_ACPI_6_6_GIC,
      .Length                        = sizeof (EFI_ACPI_6_6_GIC_STRUCTURE),
      .PhysicalBaseAddress           = FixedPcdGet64 (PcdGicInterruptInterfaceBase),
      .GICV                          = FixedPcdGet64 (PcdGicInterruptInterfaceBase) + 0x4000,
      .GICH                          = FixedPcdGet64 (PcdGicInterruptInterfaceBase) + 0x2000,
      .Flags                         = EFI_ACPI_6_6_GIC_ENABLED,
      .MPIDR                         = 0x100,
      .PerformanceInterruptGsiv      = 57,
      .VGICMaintenanceInterrupt      = 25,
      .CPUInterfaceNumber            = 4,
      .AcpiProcessorUid              = 0,
      .ProcessorPowerEfficiencyClass = 0
    },

    //
    // Core 1 (Cortex-A53, MPIDR 0x101; cluster 1 -> GIC CPU interface 5)
    //
    [1] = {
      .Type                          = EFI_ACPI_6_6_GIC,
      .Length                        = sizeof (EFI_ACPI_6_6_GIC_STRUCTURE),
      .PhysicalBaseAddress           = FixedPcdGet64 (PcdGicInterruptInterfaceBase),
      .GICV                          = FixedPcdGet64 (PcdGicInterruptInterfaceBase) + 0x4000,
      .GICH                          = FixedPcdGet64 (PcdGicInterruptInterfaceBase) + 0x2000,
      .Flags                         = EFI_ACPI_6_6_GIC_ENABLED,
      .MPIDR                         = 0x101,
      .PerformanceInterruptGsiv      = 58,
      .VGICMaintenanceInterrupt      = 25,
      .CPUInterfaceNumber            = 5,
      .AcpiProcessorUid              = 1,
      .ProcessorPowerEfficiencyClass = 0
    },

    //
    // Core 2 (Cortex-A53, MPIDR 0x102; cluster 1 -> GIC CPU interface 6)
    //
    [2] = {
      .Type                          = EFI_ACPI_6_6_GIC,
      .Length                        = sizeof (EFI_ACPI_6_6_GIC_STRUCTURE),
      .PhysicalBaseAddress           = FixedPcdGet64 (PcdGicInterruptInterfaceBase),
      .GICV                          = FixedPcdGet64 (PcdGicInterruptInterfaceBase) + 0x4000,
      .GICH                          = FixedPcdGet64 (PcdGicInterruptInterfaceBase) + 0x2000,
      .Flags                         = EFI_ACPI_6_6_GIC_ENABLED,
      .MPIDR                         = 0x102,
      .PerformanceInterruptGsiv      = 59,
      .VGICMaintenanceInterrupt      = 25,
      .CPUInterfaceNumber            = 6,
      .AcpiProcessorUid              = 2,
      .ProcessorPowerEfficiencyClass = 0
    },

    //
    // Core 3 (Cortex-A53, MPIDR 0x103; cluster 1 -> GIC CPU interface 7)
    //
    [3] = {
      .Type                          = EFI_ACPI_6_6_GIC,
      .Length                        = sizeof (EFI_ACPI_6_6_GIC_STRUCTURE),
      .PhysicalBaseAddress           = FixedPcdGet64 (PcdGicInterruptInterfaceBase),
      .GICV                          = FixedPcdGet64 (PcdGicInterruptInterfaceBase) + 0x4000,
      .GICH                          = FixedPcdGet64 (PcdGicInterruptInterfaceBase) + 0x2000,
      .Flags                         = EFI_ACPI_6_6_GIC_ENABLED,
      .MPIDR                         = 0x103,
      .PerformanceInterruptGsiv      = 60,
      .VGICMaintenanceInterrupt      = 25,
      .CPUInterfaceNumber            = 7,
      .AcpiProcessorUid              = 3,
      .ProcessorPowerEfficiencyClass = 0
    }
  },

  .GicD = {
    .Type                            = EFI_ACPI_6_6_GICD,
    .Length                          = sizeof (EFI_ACPI_6_6_GIC_DISTRIBUTOR_STRUCTURE),
    .PhysicalBaseAddress             = FixedPcdGet64 (PcdGicDistributorBase),
    .GicVersion                      = EFI_ACPI_6_6_GIC_V2
  }
};

//
// MADT Table Reference
//
VOID *ReferenceAcpiTable = (VOID*)&MadtTable;
